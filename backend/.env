PORT=3001

# Gemini API key (used when Ollama is not running)
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Local Ollama config (true offline inference)
# Install Ollama: https://ollama.com  then run: ollama pull gemma3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# Whisper model size: tiny | base | small | medium (default: small)
WHISPER_MODEL=small

# Database encryption key (32+ chars recommended)
# If not set, uses hostname-derived key (still encrypted, less portable)
DB_ENCRYPTION_KEY=change_this_to_a_strong_secret_key
