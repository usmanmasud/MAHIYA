PORT=3001
NODE_ENV=production

# Clinic PIN — required to access the app
CLINIC_PIN=1234

# Gemini API key (fallback when Ollama not running)
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Local Ollama config (true offline inference)
# Install: https://ollama.com  then run: ollama pull gemma3n
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3n

# Whisper model: tiny | base | small | medium (default: small)
WHISPER_MODEL=small

# Database encryption key (32+ chars recommended)
DB_ENCRYPTION_KEY=change_this_to_a_strong_secret_key
